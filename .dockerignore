# Build context is the repo root (infra/compose.yml: context ".."). Keep the context small
# and keep secrets / local state out of every image layer.
.git
.gitignore
.claude
.env
.env.*
!.env.example
**/.env
**/.env.*
**/node_modules
**/dist
**/*.md
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
**/*.test
**/*.out
**/coverage
**/*.tsbuildinfo
backend-go/bin
backend-go/data
data
docs
infra
Makefile
