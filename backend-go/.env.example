# Local development defaults for the Go server (no secrets: tailnet-only, no app auth).
# Load with: set -a; . ./.env; set +a; go run ./cmd/server
# BASE_PATH is the URL prefix kept end-to-end ("" serves at the root).
BASE_PATH=/wesele
PORT=8080
DB_PATH=./data/stoliki.db
# Built SPA (frontend-web/dist); an empty/missing dir just means no SPA is served.
WEB_ROOT=../frontend-web/dist
