# Local development defaults for the Go server.
# Load with: set -a; . ./.env; set +a; go run ./cmd/server
# BASE_PATH is the URL prefix kept end-to-end ("" serves at the root).
BASE_PATH=/wesele
PORT=8080
DB_PATH=./data/stoliki.db
# Built SPA (frontend-web/dist); an empty/missing dir just means no SPA is served.
WEB_ROOT=../frontend-web/dist
# Shared PIN of the access gate. Unset/empty = gate off (open, dev default). Any length/charset;
# longer is safer. Never commit a real value; the deployed one lives in infra/.env.
# STOLIKI_PIN=
