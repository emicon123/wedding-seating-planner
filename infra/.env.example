# Stoliki deployment config. Copy to infra/.env (gitignored, chmod 600). Every value below has a default
# EXCEPT STOLIKI_PIN, which is a secret and required: docker compose refuses to run without it.

# Shared access PIN for the whole app (docs/architecture/05-access-gate.md). Any length and characters,
# compared byte for byte. A long value is recommended, especially if the app is ever
# reachable from the internet. Changing it and restarting logs every device out. Never commit the real value.
STOLIKI_PIN=

# URL prefix kept end-to-end. The SPA is built with base /wesele/, so changing this needs a rebuild
# of the frontend too; leave it as is.
BASE_PATH=/wesele

# Host port on 127.0.0.1 that tailscale serve forwards to (container listens on 8080).
# Taken on this Pi: 80, 3001, 5580, 8080 (receipts, loopback), 8090-8093, 8123, 8443.
STOLIKI_HOST_PORT=8094

# Container memory limit and Go soft heap limit (keep GOMEMLIMIT below STOLIKI_MEM_LIMIT).
STOLIKI_MEM_LIMIT=192m
GOMEMLIMIT=150MiB

# Not configurable here (fixed in compose.yml): PORT=8080, DB_PATH=/data/stoliki.db (named volume
# stoliki-data), WEB_ROOT=/app/web.
